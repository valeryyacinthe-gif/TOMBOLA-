rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /editions/{id} {
      allow read: if resource.data.status in ['published', 'preparation'] || isAdmin();
      allow write: if isAdmin();
    }
    match /prizes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /participations/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /payments/{id} { allow read, write: if isAdmin(); }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
